rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isSuspended == false;
    }
    function admin() { return active() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /reports/{uid}/{reportId}/{name} {
      allow read: if active();
      allow create: if resource == null && active() && request.auth.uid == uid && name == 'photo.jpg'
        && request.resource.size < 1024 * 1024 && request.resource.contentType == 'image/jpeg';
    }
    match /receipts/{uid}/{paymentId}/{name} {
      allow read: if active() && (request.auth.uid == uid || admin());
      allow create: if resource == null && active() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)|application/pdf');
    }
    match /cats/{path=**} { allow read: if active(); }
  }
}
