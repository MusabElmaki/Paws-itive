rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && request.auth.token.email_verified == true && profile().isSuspended == false && profile().status != 'suspended'; }
    function admin() { return active() && profile().role == 'admin'; }
    function volunteer() { return active() && (profile().role == 'admin' || (profile().role == 'volunteer' && profile().isApprovedVolunteer == true && profile().status == 'active')); }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    match /users/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['email','fullName','role','status','createdAt','phoneNumber','photoUrl','bio','points','isApprovedVolunteer','isSuspended'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 100
        && request.resource.data.role == 'user' && request.resource.data.status == 'active'
        && request.resource.data.points == 0 && request.resource.data.isApprovedVolunteer == false && request.resource.data.isSuspended == false;
      allow update: if self(uid) && active() && changedOnly(['fullName','phoneNumber','photoUrl','bio','pushToken','available'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 100;
      match /notification_reads/{notificationId} { allow read, write: if self(uid) && active(); }
    }
    match /volunteers/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid) && request.resource.data.keys().hasOnly(['userId','approvalStatus','createdAt'])
        && request.resource.data.userId == uid && request.resource.data.approvalStatus == 'pending';
    }
    match /cats/{catId} {
      allow read: if active();
      match /timeline/{entryId} { allow read: if active(); }
    }
    match /reports/{reportId} { allow read: if active(); }
    match /notifications/{notificationId} {
      allow read: if active() && (resource.data.targetUserId == request.auth.uid || resource.data.audience == 'all'
        || (resource.data.audience == 'volunteers' && volunteer()) || (resource.data.audience == 'admins' && admin()));
    }
    match /donations/{id} { allow read: if admin() || (active() && resource.data.userId == request.auth.uid); }
    match /payments/{id} { allow read: if admin() || (active() && resource.data.userId == request.auth.uid); }
    match /orders/{id} { allow read: if admin() || (active() && resource.data.userId == request.auth.uid); }
    match /leaderboard/{id} { allow read: if active(); }
    match /shop_items/{id} {
      allow read: if active();
      allow create, update: if admin() && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 100000 && request.resource.data.active is bool;
      allow delete: if admin();
    }
    match /clinics/{id} { allow read: if active(); allow write: if admin(); }
    match /fundraising/{id} {
      allow read: if active();
      allow create: if volunteer() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.raisedAmount == 0 && request.resource.data.goalAmount > 0 && request.resource.data.goalAmount <= 100000;
      allow update: if volunteer() && (admin() || resource.data.createdBy == request.auth.uid)
        && changedOnly(['title','description','goalAmount','imageUrl','catId','active'])
        && request.resource.data.goalAmount > 0 && request.resource.data.goalAmount <= 100000;
    }
    match /fund_requests/{id} {
      allow read: if admin() || (active() && resource.data.requestedBy == request.auth.uid);

    }
    match /finance/{id} { allow read: if admin(); }
    match /ledger/{id} { allow read: if admin(); }
    match /audit_log/{id} { allow read: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
